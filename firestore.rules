rules_version = '2';
// Nothing is readable or writable from a browser. The dashboard gets its data from the Cloud Run backend, which checks the
// sign-in and reads Firestore with the admin SDK. (Before 17 Oct 2026 the dashboard read farmers, calls and messages directly
// and anyone with the public web config could read phone numbers and transcripts: AUDIT.md A1.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
