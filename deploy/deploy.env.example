# Settings for deploy/deploy.sh. Copy this file to deploy/deploy.env (git-ignored) so you do not
# retype them on every deploy:
#   cp deploy/deploy.env.example deploy/deploy.env
# deploy.sh reads it automatically. A variable already exported in your shell wins over the file.
# Every variable is explained in ENV.md. Automatic deploys use GitHub settings instead, listed there.

# Your Google Cloud project id (required).
PROJECT=
REGION=asia-southeast1

# Names of the Cloud Run service and job.
# SERVICE=harvest-gateway
# JOB=harvest-forecast

# Passed to the service. Leave blank for the defaults in ENV.md.
# MILL_NAME=Koperasi Sawit Maju
# DEMO_LANGUAGE=Bahasa Indonesia

# How the service reaches Gemini: vertex (default, no key, the service signs in with its own Google
# account) or api_key (a Gemini API key in the gemini-api-key secret).
# GEMINI_BACKEND=vertex
# Vertex region for the Live API, and the Live model's Vertex name (only used with vertex).
# GOOGLE_CLOUD_LOCATION=us-central1
# LIVE_MODEL=gemini-live-2.5-flash-native-audio
# VERTEX_ACCESS_TOKEN is for LOCAL runs only (a short-lived token, see ENV.md). The deploy never passes it:
# Cloud Run signs in to Vertex with its own service account.

# More than one crop campaign at a time (the dashboard's New campaign). On by default; false is the kill switch.
# MULTI_CROP=true
# Call recording (only when the farmer agrees): create the bucket once with deploy/setup-call-audio.sh, then set its name.
# Unset = Cloud Run does not record calls. (CALL_AUDIO_DIR is for local runs and is not passed.)
# CALL_AUDIO_BUCKET=harvest-511117-call-audio
# CALL_AUDIO_RETENTION_DAYS=90

# Optional: JSON web config from the Firebase console (live Firestore listeners in the dashboard).
# Single-quote it: FIREBASE_WEB_CONFIG='{"apiKey":"...","projectId":"..."}'
# FIREBASE_WEB_CONFIG=

# Signs sign-in tokens. Blank = a new random one each deploy (everyone picks their role again).
# Make one with: openssl rand -hex 32
# JWT_SECRET=
# Weekly job token (Cloud Scheduler calls /api/jobs/weekly every hour (the job itself acts on Monday 06:00 WIB) Jakarta time when set).
# JOB_TOKEN=
# Text messages: off (recorded only), sms or whatsapp; planner alert numbers, comma-separated.
# MESSAGING_CHANNEL=off
# TWILIO_WHATSAPP_FROM=
# PLANNER_ALERT_TO=

# Password of the built-in demo accounts, shown on the sign-in page. Blank = harvest-demo.
# DEMO_PASSWORD=

# true on the very first deploy only: it replaces everything in Firestore with the demo data.
SEED_DEMO_DATA=false
# true once the Google Cloud APIs are enabled (the first deploy enables them).
SKIP_API_ENABLE=false
# Cloud Run limits (defaults shown): the most servers, calls per server, and memory per server.
# MAX_INSTANCES=10
# CONCURRENCY=20
# MEMORY=1Gi

# Real phone channel (VA-8, off by default). Needs the twilio-auth-token secret in Secret Manager first.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# REAL_CALLS_ENABLED=false
# REAL_CALL_ALLOWLIST=
# PHONE_CALLS_AT_ONCE=3
# BIGQUERY_DATASET=harvest
# BIGQUERY_LOCATION=asia-southeast1
# DAILY_BRIEF=true
# MAPS_API_KEY=
