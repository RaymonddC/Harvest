# Copy to .env (never commit it) or export these before running the backend.
# Gemini API key from AI Studio. Or use Vertex AI instead:
#   GOOGLE_GENAI_USE_VERTEXAI=true GOOGLE_CLOUD_PROJECT=... GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=

# memory (local, seeded on start) or firestore
STORE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=

LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
TEXT_MODEL=gemini-2.5-flash
VOICE_NAME=Kore
MILL_NAME=Koperasi Sawit Maju
PLANNER_NAME=Dewi
DEMO_LANGUAGE=Bahasa Indonesia
DEMO_CROP=palm
# Second caption line on the call screen; empty turns it off.
CAPTION_TRANSLATE_TO=English
MAX_CALL_SECONDS=360
# First Monday of the forecast horizon; defaults to next Monday.
PLAN_START=
TARGET_KG_PER_WEEK=100000
GAP_TOLERANCE=0.2
# Set to require X-Planner-Token on dashboard actions.
PLANNER_TOKEN=
# JSON web config from the Firebase console; enables Firestore live listeners in the dashboard.
FIREBASE_WEB_CONFIG=
