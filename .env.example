# Local settings for the backend. Copy this file to `.env` (git-ignored) and fill in what you need:
#   cp .env.example .env
# The backend reads `.env` from the repo root or from backend/ when it starts. Variables already
# set in your shell win over the file, and blank values are ignored. Every variable is explained
# in ENV.md; the cloud and CI settings are in deploy/deploy.env.example.

# ---- Gemini (required for the voice call; everything else works without it) ----
# Key from https://aistudio.google.com/apikey. Google's newer "AQ." keys are reported to fail with the
# Gemini API; if yours does, use Vertex AI instead (no key; sign in once with
# `gcloud auth application-default login`) and set these three, leaving GOOGLE_API_KEY blank:
#   GOOGLE_GENAI_USE_VERTEXAI=true
#   GOOGLE_CLOUD_PROJECT=your-project-id
#   GOOGLE_CLOUD_LOCATION=us-central1
#   LIVE_MODEL=gemini-live-2.5-flash-native-audio
# Local runs only, when you cannot use `gcloud auth application-default login`: a short-lived token from
# `gcloud auth print-access-token --impersonate-service-account=<service account>`. With GOOGLE_GENAI_USE_VERTEXAI
# on, the backend uses it as the Vertex credential. It expires in about an hour. Never commit it; never set it on Cloud Run.
# VERTEX_ACCESS_TOKEN=
GOOGLE_API_KEY=
LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
TEXT_MODEL=gemini-3.8-flash
VOICE_NAME=Kore
# Silence (ms) that ends the farmer's turn. Lower = faster replies, but may cut off slow speakers.
VAD_SILENCE_MS=400

# ---- Storage ----
# memory (local, seeded on start) or firestore
STORE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=
# Reload the demo data on every start. Defaults to true for memory and false for firestore.
# SEED_ON_START=true

# ---- The demo ----
MILL_NAME=Koperasi Sawit Maju
DEMO_LANGUAGE=Bahasa Indonesia
DEMO_CROP=palm
# Let planners run a campaign for more than one crop at a time (New campaign on the dashboard). On by default;
# false turns it off.
# MULTI_CROP=true
# Record calls (both sides, stereo MP3) when the farmer agrees to it, into this folder. Unset = calls are not recorded.
# The consent notice then says the call is recorded and kept for CALL_AUDIO_RETENTION_DAYS days. A cloud
# server's disk does not last, so Cloud Run uses CALL_AUDIO_BUCKET instead.
# CALL_AUDIO_DIR=./call_audio
# Or a Cloud Storage bucket (used instead of the folder when set; see deploy/setup-call-audio.sh). This is what Cloud Run uses.
# CALL_AUDIO_BUCKET=harvest-511117-call-audio
# CALL_AUDIO_RETENTION_DAYS=90
# Second caption line on the call screen; empty turns it off.
CAPTION_TRANSLATE_TO=English
# First Monday of the forecast horizon; defaults to next Monday.
PLAN_START=
# Protects POST /api/jobs/weekly (the Monday job: roll the weeks, snapshot promises, start weekly campaigns).
# Cloud Scheduler sends it as the X-Job-Token header. Empty: the job endpoint is off.
JOB_TOKEN=
# Text messages (deal confirmations to farmers, alerts to the planner). off: recorded in the outbox, not sent.
# sms or whatsapp: sent over Twilio to numbers on REAL_CALL_ALLOWLIST. WhatsApp needs TWILIO_WHATSAPP_FROM.
MESSAGING_CHANNEL=off
TWILIO_WHATSAPP_FROM=
# Numbers that get the planner's alerts (a new gap, an offer waiting), comma-separated.
PLANNER_ALERT_TO=
FORECAST_WEEKS=5
TARGET_KG_PER_WEEK=100000
GAP_TOLERANCE=0.2
MAX_CALL_ATTEMPTS=2
MAX_CALL_SECONDS=360

# ---- Sign-in (username and password; the built-in accounts share a demo password) ----
# Planner actions need the planner role. Set AUTH_REQUIRED=false to leave them open.
AUTH_REQUIRED=true
# Signs the tokens. Empty is fine locally (a new one each start). Set a long random value
# (at least 32 characters) in the cloud, or each instance signs differently.
JWT_SECRET=
JWT_TTL_SECONDS=43200
# Password of the built-in accounts (dewi, budi, guest, farmer). The sign-in page shows it so
# judges can get in. Empty turns those demo logins off; then only users with their own password sign in.
DEMO_PASSWORD=harvest-demo

# Set to 1 to ignore .env files entirely (the tests do this so your own .env cannot change them).
# HARVEST_NO_DOTENV=1

# ---- Web serving ----
# Folder of static pages the backend serves. Defaults to the repo's web/ folder; the cloud
# deploy leaves it unset because Firebase Hosting serves the pages.
# STATIC_DIR=
# Allowed browser origins, comma-separated. * allows any.
CORS_ORIGINS=*
# JSON web config from the Firebase console; enables Firestore live listeners in the dashboard.
FIREBASE_WEB_CONFIG=

# ---- Real phone channel (VA-8, off by default) ----
# All four must be set to dial out; leave blank to keep browser-only calling. Needs a paid
# Twilio account - trial accounts can only call pre-verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# This service's own https URL (e.g. the Cloud Run URL deploy.sh prints). Used both
# to build the TwiML webhook Twilio calls back and to validate its signature -
# never trust the URL Cloud Run's proxy hands the app for that.
PUBLIC_BASE_URL=

# Extra safety gate on top of the four above: dial_now still refuses every real call
# unless BOTH of these allow it. Deliberately env-only, not a dashboard toggle - set
# it once before testing, not something to flip live. Comma-separated E.164 numbers;
# any spacing/formatting is fine, it's normalized before comparing. Set to * (same
# convention as CORS_ORIGINS) to allow any number - production, not testing.
REAL_CALLS_ENABLED=false
REAL_CALL_ALLOWLIST=
# How many numbers planners may add to the allowlist from the dashboard (Farmers page). 0 turns that off.
WEB_ALLOWLIST_MAX=20
